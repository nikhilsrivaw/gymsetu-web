GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase (anon key is safe to expose — it's public)
VITE_SUPABASE_URL="https://gijqmqnxtwiznxdwjhle.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# PayU — only the merchant key goes in client env. The SALT must NEVER be
# exposed; set it as a Supabase Edge Function secret instead (see docs/PAYU_SETUP.md):
#   supabase secrets set PAYU_MERCHANT_KEY=...
#   supabase secrets set PAYU_SALT=...
#   supabase secrets set PAYU_MODE=test            # or "live"
#   supabase secrets set APP_URL=https://gymsetu.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# WhatsApp support number (country code + number, no + or spaces, e.g. 919876543210)
VITE_WHATSAPP_NUMBER="919876543210"
